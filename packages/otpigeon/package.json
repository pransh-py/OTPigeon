{
  "name": "otpigeon",
  "version": "0.3.0-beta.1",
  "description": "Embedded WhatsApp messaging with explicit sessions, bounded queues and an optional durable HTTP gateway",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./testing": {
      "types": "./testing.d.ts",
      "default": "./src/testing.js"
    },
    "./gateway": {
      "types": "./gateway.d.ts",
      "default": "./src/gateway.js"
    },
    "./verification": {
      "types": "./verification.d.ts",
      "default": "./src/verification.js"
    }
  },
  "files": [
    "src",
    "*.d.ts",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "peerDependencies": {
    "whatsapp-web.js": "1.34.7"
  },
  "peerDependenciesMeta": {
    "whatsapp-web.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "7.0.2",
    "prettier": "3.8.1"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit --strict --module nodenext --target es2022 test/consumer.ts",
    "format": "prettier --write src test examples *.d.ts package.json",
    "format:check": "prettier --check src test examples *.d.ts package.json",
    "prepack": "npm run format:check && npm run typecheck && npm test"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pransh-py/OTPigeon.git",
    "directory": "packages/otpigeon"
  },
  "publishConfig": {
    "access": "public"
  }
}
