MONGODB_URL=mongodb://127.0.0.1:27017/?replicaSet=otpigeon
MONGODB_DB_NAME=otpigeon_gateway
OTPIGEON_SECRET=replace-with-a-generated-secret-at-least-32-characters
OTPIGEON_EXPIRY_SECONDS=300
OTPIGEON_COOLDOWN_SECONDS=60
OTPIGEON_MAX_ATTEMPTS=5
OTPIGEON_MAX_RESENDS=3
OTPIGEON_DESTINATION_SENDS_PER_HOUR=5
OTPIGEON_DESTINATION_GUESSES_PER_HOUR=10
OTPIGEON_PROJECT_SENDS_PER_HOUR=1000
OTPIGEON_ENABLE_LEGACY=false
# Legacy PoC only; set explicit independent generated secrets to opt in.
OTPIGEON_LEGACY_ADMIN_TOKEN=
OTP_SENDER_MODE=mock
WHATSAPP_SENDER_URL=http://127.0.0.1:3001
WHATSAPP_SENDER_API_KEY=
WHATSAPP_SENDER_TIMEOUT_SECONDS=10
